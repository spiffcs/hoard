<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>hoard-scan</string>
	<key>CFBundleDisplayName</key>
	<string>hoard</string>
	<key>CFBundleIdentifier</key>
	<string>dev.spiffcs.hoard.scan</string>
	<key>CFBundleExecutable</key>
	<string>hoard-scan</string>
	<key>CFBundleIconFile</key>
	<string>hoard-scan</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- 14.0 is where Network.framework's peer-to-peer Bonjour browsing behaves
	     the way the link depends on. The helper opens no camera of its own, so
	     nothing here needs a camera key: the phone owns the camera and asks for
	     its own permission. -->
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The link to the phone is Bonjour on the local network. macOS attributes
	     that permission to the bundle's signed identity, which is why
	     build-scan.sh assembles a .app rather than shipping a bare executable. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>hoard receives card reads from Hoardling on your iPhone.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_hoardscan._tcp</string>
	</array>
</dict>
</plist>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/spiffcs/hoard/main/schema/json/schema-1.1.4.json",
  "$defs": {
    "Card": {
      "properties": {
        "name": {
          "type": "string"
        },
        "scryfallId": {
          "type": "string"
        },
        "mtgjsonUuid": {
          "type": "string"
        },
        "setCode": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "finish": {
          "type": "string",
          "enum": [
            "nonfoil",
            "foil",
            "etched"
          ]
        },
        "condition": {
          "type": "string",
          "description": "Condition is the copy's wear — \"nm\", \"lp\", \"mp\", \"hp\", \"dmg\" — absent\nwhen nobody has assessed it, which is most holdings. It describes the\ncopies held rather than the printing, so two entries of one printing can\ndiffer by it.\n\nIt never affects a value in these documents: no source hoard reads\npublishes a per-condition price, so every copy is valued at the\nprinting's price whatever its condition."
        },
        "lang": {
          "type": "string",
          "description": "Lang is Scryfall's language code for the printing (\"en\", \"ja\", \"zhs\"),\nabsent when hoard has not stored the card's document. Language is part\nof a printing's identity — Scryfall mints a distinct id per language —\nso this names which of them ScryfallID refers to rather than adding a\ndimension to it."
        },
        "colorIdentity": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "ColorIdentity is Scryfall's color_identity: WUBRG letters, empty for a\ncolorless card, absent when the identity is not known to hoard (the\ncard's document was never fetched, or the emitting query predates it)."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "scryfallId",
        "setCode",
        "number",
        "finish"
      ],
      "description": "Card identifies one printing in one finish."
    },
    "Comp": {
      "properties": {
        "card": {
          "$ref": "#/$defs/Card"
        },
        "copies": {
          "type": "integer"
        },
        "valueUsd": {
          "type": "number"
        },
        "marketUsd": {
          "type": "number",
          "description": "MarketUsd is tcgplayer's sales-derived market price."
        },
        "cardKingdomUsd": {
          "type": "number"
        },
        "manapoolUsd": {
          "type": "number"
        },
        "lowUsd": {
          "type": "number"
        },
        "lowFrom": {
          "type": "string"
        },
        "buylistUsd": {
          "type": "number"
        },
        "buylistTo": {
          "type": "string"
        },
        "spread": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "card",
        "copies",
        "valueUsd",
        "lowUsd",
        "lowFrom"
      ],
      "description": "Comp is one owned printing's comp sheet: each vendor's USD figure for the owned finish."
    },
    "DeckAggregate": {
      "properties": {
        "count": {
          "type": "integer"
        },
        "totalCopies": {
          "type": "integer"
        },
        "valueUsd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "count",
        "totalCopies",
        "valueUsd"
      ],
      "description": "DeckAggregate rolls every deck into one line, as the report's totals show them; the per-deck split lives in the summary document."
    },
    "DeckTotals": {
      "properties": {
        "name": {
          "type": "string"
        },
        "distinctCards": {
          "type": "integer"
        },
        "totalCopies": {
          "type": "integer"
        },
        "valueUsd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "distinctCards",
        "totalCopies",
        "valueUsd"
      ],
      "description": "DeckTotals is one deck's totals, ordered by value as the summary lists them."
    },
    "FiredWatch": {
      "properties": {
        "card": {
          "$ref": "#/$defs/Card"
        },
        "op": {
          "type": "string",
          "enum": [
            "under",
            "over"
          ]
        },
        "thresholdUsd": {
          "type": "number"
        },
        "priceUsd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "card",
        "op",
        "thresholdUsd",
        "priceUsd"
      ],
      "description": "FiredWatch is one alert: the card, the threshold it crossed, and the price that crossed it."
    },
    "GrandTotal": {
      "properties": {
        "totalCopies": {
          "type": "integer"
        },
        "valueUsd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "totalCopies",
        "valueUsd"
      ],
      "description": "GrandTotal is the whole hoard."
    },
    "Holding": {
      "properties": {
        "card": {
          "$ref": "#/$defs/Card"
        },
        "count": {
          "type": "integer"
        },
        "container": {
          "type": "string"
        },
        "containerKind": {
          "type": "string",
          "enum": [
            "binder",
            "deck"
          ]
        },
        "board": {
          "type": "string"
        },
        "priceUsd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "card",
        "count",
        "container",
        "containerKind",
        "board"
      ],
      "description": "Holding is a quantity of one card in one container."
    },
    "Holdings": {
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/Holding"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "rows"
      ],
      "description": "Holdings is every requested holding, one row per printing-finish-container, in the export's canonical order — the same data as the canonical CSV."
    },
    "Market": {
      "properties": {
        "comparedPrintings": {
          "type": "integer",
          "description": "ComparedPrintings is how many owned printings had two or more vendors,\nso a consumer knows how much ground the analysis covered."
        },
        "opportunities": {
          "items": {
            "$ref": "#/$defs/Opportunity"
          },
          "type": "array"
        },
        "comps": {
          "items": {
            "$ref": "#/$defs/Comp"
          },
          "type": "array",
          "description": "Comps is every compared printing's per-vendor sheet, ordered by\nvalueUsd descending — the data behind the COMPS table."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "comparedPrintings",
        "opportunities",
        "comps"
      ],
      "description": "Arbitrage is one pass of vendor disagreement over everything held: the full ranking behind all three tables, not the display's top-N."
    },
    "Movers": {
      "properties": {
        "since": {
          "type": "string",
          "description": "Since is the comparison cutoff (RFC 3339): each card's newest price\nagainst its last price recorded on or before this instant."
        },
        "recordedSince": {
          "type": "string",
          "description": "RecordedSince is the oldest price observation held (RFC 3339). When it\nis later than Since, history simply does not reach as far back as the\nquestion asked."
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/PriceChange"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "since",
        "changes"
      ],
      "description": "Movers is the price changes between two observations, every change rather than the display's top-N, ordered by absolute impact."
    },
    "Opportunity": {
      "properties": {
        "card": {
          "$ref": "#/$defs/Card"
        },
        "copies": {
          "type": "integer"
        },
        "valueUsd": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "enum": [
            "arbitrage",
            "liquid",
            "below-market"
          ]
        },
        "buyUsd": {
          "type": "number"
        },
        "buyFrom": {
          "type": "string"
        },
        "marketUsd": {
          "type": "number",
          "description": "MarketUsd is tcgplayer's market price — computed from actual sales —\nwhen the printing has one; every ranking anchors on it."
        },
        "belowMarket": {
          "type": "number",
          "description": "BelowMarket is the fraction the cheapest ask sits under marketUsd."
        },
        "sellUsd": {
          "type": "number"
        },
        "sellTo": {
          "type": "string"
        },
        "profitUsd": {
          "type": "number",
          "description": "ProfitUsd is sellUsd − marketUsd per copy: what a buylist pays over\nthe last-sold price. Positive is genuine arbitrage."
        },
        "liquidity": {
          "type": "number",
          "description": "Liquidity is the fraction of marketUsd a shop will pay."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "card",
        "copies",
        "valueUsd",
        "kind",
        "buyUsd",
        "buyFrom"
      ],
      "description": "Opportunity is one owned printing-and-finish with the vendor quotes that make it interesting, tagged with the question it answers: \"arbitrage\" (a shop pays more than the cheapest retail), \"liquid\" (buylist close to retail), or \"spread\" (vendors disagree)."
    },
    "PriceChange": {
      "properties": {
        "card": {
          "$ref": "#/$defs/Card"
        },
        "copies": {
          "type": "integer"
        },
        "oldUsd": {
          "type": "number"
        },
        "newUsd": {
          "type": "number"
        },
        "impactUsd": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "description": "Source names where the new price came from: \"scryfall\", or the vendor\nbehind a fallback."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "card",
        "copies",
        "oldUsd",
        "newUsd",
        "impactUsd",
        "source"
      ],
      "description": "PriceChange is one printing-and-finish whose per-copy price moved."
    },
    "Report": {
      "properties": {
        "asOf": {
          "type": "string",
          "description": "AsOf is when the prices were observed (RFC 3339); absent when nothing\nhas ever been priced."
        },
        "total": {
          "$ref": "#/$defs/GrandTotal"
        },
        "binder": {
          "$ref": "#/$defs/Totals"
        },
        "decks": {
          "$ref": "#/$defs/DeckAggregate"
        },
        "binders": {
          "items": {
            "$ref": "#/$defs/DeckTotals"
          },
          "type": "array"
        },
        "topHoldings": {
          "items": {
            "$ref": "#/$defs/ReportHolding"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceCount"
          },
          "type": "array"
        },
        "unpriced": {
          "$ref": "#/$defs/UnpricedCount"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "total",
        "binder",
        "decks",
        "binders",
        "topHoldings",
        "sources",
        "unpriced"
      ],
      "description": "Report is the dated valuation: the totals, each binder, the most valuable holdings, and where every price came from."
    },
    "ReportHolding": {
      "properties": {
        "card": {
          "$ref": "#/$defs/Card"
        },
        "copies": {
          "type": "integer"
        },
        "priceUsd": {
          "type": "number"
        },
        "valueUsd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "card",
        "copies",
        "valueUsd"
      ],
      "description": "ReportHolding is one itemized holding: the per-copy price and what the copies are worth together."
    },
    "SourceCount": {
      "properties": {
        "source": {
          "type": "string"
        },
        "printings": {
          "type": "integer"
        },
        "copies": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source",
        "printings",
        "copies"
      ],
      "description": "SourceCount is one price source's coverage: distinct printing-finish combinations and the physical copies they account for."
    },
    "Summary": {
      "properties": {
        "binder": {
          "$ref": "#/$defs/Totals"
        },
        "decks": {
          "items": {
            "$ref": "#/$defs/DeckTotals"
          },
          "type": "array"
        },
        "total": {
          "$ref": "#/$defs/GrandTotal"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "binder",
        "decks",
        "total"
      ],
      "description": "Summary is the hoard's totals: the loose collection, each deck, and the grand total, as the summary table reports them."
    },
    "Totals": {
      "properties": {
        "distinctCards": {
          "type": "integer"
        },
        "totalCopies": {
          "type": "integer"
        },
        "valueUsd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "distinctCards",
        "totalCopies",
        "valueUsd"
      ],
      "description": "Totals rolls one container group up: how many distinct printings, how many physical copies, and their market value."
    },
    "Unpriced": {
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/UnpricedRow"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "rows"
      ],
      "description": "Unpriced is every holding no source can price — the copies counting as $0.00 in every total."
    },
    "UnpricedCount": {
      "properties": {
        "printings": {
          "type": "integer"
        },
        "copies": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "printings",
        "copies"
      ],
      "description": "UnpricedCount is the residue no source covers, counted the same way as SourceCount."
    },
    "UnpricedRow": {
      "properties": {
        "card": {
          "$ref": "#/$defs/Card"
        },
        "copies": {
          "type": "integer"
        },
        "containers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "card",
        "copies",
        "containers"
      ],
      "description": "UnpricedRow is one unpriced card-and-finish and the containers holding it."
    },
    "WatchCheck": {
      "properties": {
        "checked": {
          "type": "integer"
        },
        "fired": {
          "items": {
            "$ref": "#/$defs/FiredWatch"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "checked",
        "fired"
      ],
      "description": "WatchCheck is one pass over the price watches: how many could be evaluated (an unpriced card answers neither \"under\" nor \"over\" and is not counted), and the watches that just crossed into their condition."
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "summary",
        "holdings",
        "unpriced",
        "movers",
        "market",
        "report",
        "watch"
      ]
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "holdings": {
      "$ref": "#/$defs/Holdings"
    },
    "unpriced": {
      "$ref": "#/$defs/Unpriced"
    },
    "movers": {
      "$ref": "#/$defs/Movers"
    },
    "market": {
      "$ref": "#/$defs/Market"
    },
    "report": {
      "$ref": "#/$defs/Report"
    },
    "watch": {
      "$ref": "#/$defs/WatchCheck"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "kind"
  ],
  "description": "Document is the envelope every hoard JSON emission shares: a schema version, a kind, and the one payload the kind names."
}
